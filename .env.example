# Copy to .env and fill in. Every setting is optional unless marked REQUIRED.

# --- Core -------------------------------------------------------------------
# development (default when running from source) or production (the Docker image)
LEASEKEEP_ENV=production
# REQUIRED in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# REQUIRED in production: the host name(s) people use to reach Leasekeep.
DJANGO_ALLOWED_HOSTS=leasekeep.example.org
# Needed when served over HTTPS behind a proxy on another origin.
DJANGO_CSRF_TRUSTED_ORIGINS=https://leasekeep.example.org
# Set to false only for local testing without HTTPS (e.g. docker compose on a laptop).
DJANGO_SECURE_SSL_REDIRECT=true
LEASEKEEP_TIME_ZONE=America/New_York

# --- Database -----------------------------------------------------------------
# docker-compose.yml sets this for you. Any dj-database-url URL works.
# DATABASE_URL=postgres://leasekeep:password@localhost:5432/leasekeep
POSTGRES_PASSWORD=change-me

# --- Email --------------------------------------------------------------------
EMAIL_HOST=smtp.example.org
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Riverbend CLT <homes@example.org>
# Where to send "new request" alerts (improvements, refinances, certifications).
LEASEKEEP_STAFF_NOTIFICATION_EMAIL=

# --- Online lease fee payments (Stripe) -----------------------------------------
# Leave blank to accept checks and cash only.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# us_bank_account = ACH bank transfer. Remove card to accept ACH only.
STRIPE_PAYMENT_METHOD_TYPES=us_bank_account,card

# --- Runtime --------------------------------------------------------------------
WEB_CONCURRENCY=3
LEASEKEEP_MIGRATE_ON_START=1
